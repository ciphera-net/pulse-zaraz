{
  "name": "@ciphera-net/pulse-zaraz",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse Analytics as a Cloudflare Zaraz Managed Component — privacy-first web analytics, no cookies, no IP addresses stored, under 3 KB.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://pulse.ciphera.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciphera-net/pulse-zaraz.git"
  },
  "bugs": "https://github.com/ciphera-net/pulse-zaraz/issues",
  "keywords": [
    "managed-components",
    "webcm",
    "zaraz",
    "cloudflare",
    "analytics",
    "privacy",
    "pulse"
  ],
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest --globals",
    "bundle": "node esbuild.cjs",
    "build": "npm run typecheck && npm run test && npm run bundle"
  },
  "devDependencies": {
    "@managed-components/types": "^1.3.15",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
